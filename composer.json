{
    "name": "wadejbeckett/pricecloak-for-woocommerce",
    "description": "Logged-out visitors see no prices anywhere WooCommerce renders or serves them.",
    "type": "wordpress-plugin",
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": { "PriceCloak\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PriceCloak\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "test:standalone": "php tests/run-tests.php",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
        "sort-packages": true
    }
}
